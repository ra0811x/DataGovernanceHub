    "conditional_single": {
      "enabled": true,
      "version": "1.0",
      "title": "单字段条件判断",
      "subtitle": "按一个字段的值顺序判断输出结果。",
      "toneColor": "#0f4fa8",
      "fields": [
        {
          "key": "source_value",
          "name": "source_value",
          "type": "field_select",
          "label": "判断字段",
          "placeholder": "",
          "required": true,
          "rows": 4,
          "dataSource": "rule_source",
          "configType": "",
          "options": [],
          "valueType": "",
          "title": "",
          "text": "",
          "description": "先从当前主数据源选择一个字段，系统会用这个字段值去匹配条件数组。",
          "optionValueKey": "index",
          "transient": false,
          "action": "",
          "runtimeValueResolver": "",
          "visibleWhen": null
        },
        {
          "key": "preset_template",
          "name": "preset_template",
          "type": "select",
          "label": "条件模板",
          "placeholder": "",
          "required": false,
          "rows": 4,
          "dataSource": "",
          "configType": "",
          "options": [
            {
              "value": "",
              "label": "不使用模板"
            },
            {
              "value": "data_storage_status",
              "label": "数据存储状态判断"
            },
            {
              "value": "data_purpose_ad_class",
              "label": "处理目的判断(A-D类)"
            },
            {
              "value": "data_path_ad_class",
              "label": "流转路径判断(A-D类)"
            },
            {
              "value": "data_scenario_ad_class",
              "label": "应用场景判断(A-D类)"
            },
            {
              "value": "data_measure_ad_class",
              "label": "安全措施判断(A-D类)"
            }
          ],
          "valueType": "",
          "title": "",
          "text": "",
          "description": "模板只会覆盖 conditions 和默认值，便于快速起步，后续仍可继续手改 JSON。",
          "optionValueKey": "index",
          "transient": true,
          "action": "apply_single_conditional_template",
          "runtimeValueResolver": "detect_single_conditional_template",
          "visibleWhen": null
        },
        {
          "key": "default",
          "name": "default",
          "type": "text",
          "label": "默认值",
          "placeholder": "条件未命中时返回的值",
          "required": false,
          "rows": 4,
          "dataSource": "",
          "configType": "",
          "options": [],
          "valueType": "",
          "title": "",
          "text": "",
          "description": "所有条件都没有命中时，当前列输出这里填写的值。",
          "optionValueKey": "index",
          "transient": false,
          "action": "",
          "runtimeValueResolver": "",
          "visibleWhen": null
        },
        {
          "key": "remarks",
          "name": "remarks",
          "type": "textarea",
          "label": "备注",
          "placeholder": "补充当前规则的说明",
          "required": false,
          "rows": 3,
          "dataSource": "",
          "configType": "",
          "options": [],
          "valueType": "",
          "title": "",
          "text": "",
          "description": "建议写清楚判断口径，便于后期维护和 JSON 导入导出时理解。",
          "optionValueKey": "index",
          "transient": false,
          "action": "",
          "runtimeValueResolver": "",
          "visibleWhen": null
        },
        {
          "key": "",
          "name": "",
          "type": "info",
          "label": "字段5",
          "placeholder": "",
          "required": false,
          "rows": 4,
          "dataSource": "",
          "configType": "",
          "options": [],
          "valueType": "",
          "title": "条件数组",
          "text": "具体 conditions 数组仍可在 JSON 编辑区直接维护。",
          "description": "",
          "optionValueKey": "index",
          "transient": false,
          "action": "",
          "runtimeValueResolver": "",
          "visibleWhen": null
        }
      ],
      "summaryTemplate": "对字段 {{source_value}} 进行单字段条件判断，共 {{condition_count}} 条条件，未命中时返回 {{default}}",
      "jsonKeys": [
        "source_value",
        "conditions",
        "default",
        "remarks"
      ],
      "jsonExample": {
        "source_value": "",
        "conditions": [],
        "default": "",
        "remarks": ""
      },
      "initialValues": {},
      "saveTarget": "rule",
      "description": "适用于一个字段决定当前列输出的场景。条件数组仍在 JSON 区维护，模块区主要负责常用字段和模板辅助。",
      "effectText": "保存后会直接影响当前列按哪个字段做单字段判断，以及所有命中和兜底结果。",
      "dependencyTextTemplate": "依赖 {{rule_source_name}} 字段和当前规则中的 conditions 条件数组",
      "workflowSteps": [
        {
          "label": "读取字段",
          "text": "从 {{rule_source_name}} 读取 {{source_value}} 作为判断源值"
        },
        {
          "label": "顺序匹配",
          "text": "按 conditions 数组从上到下依次判断，当前共 {{condition_count}} 条条件"
        },
        {
          "label": "返回结果",
          "text": "命中后返回对应 result，全部未命中时返回 {{default}}"
        }
      ]
    },
    "conditional_multi": {
      "enabled": true,
      "version": "1.0",
      "title": "多字段条件判断",
      "subtitle": "支持“简单联合判断”和“条件组判断”两种模式。",
      "toneColor": "#2563eb",
      "fields": [
        {
          "key": "mode",
          "name": "mode",
          "type": "select",
          "label": "判断模式",
          "placeholder": "",
          "required": false,
          "rows": 4,
          "dataSource": "",
          "configType": "",
          "options": [
            {
              "value": "simple",
              "label": "简单模式"
            },
            {
              "value": "groups",
              "label": "条件组模式"
            }
          ],
          "valueType": "",
          "title": "",
          "text": "",
          "description": "简单模式适合一组 conditions 联合判断；条件组模式适合多组规则汇总。",
          "optionValueKey": "index",
          "transient": true,
          "action": "apply_multi_conditional_mode",
          "runtimeValueResolver": "detect_multi_conditional_mode",
          "visibleWhen": null
        },
        {
          "key": "logic",
          "name": "logic",
          "type": "select",
          "label": "条件逻辑",
          "placeholder": "",
          "required": false,
          "rows": 4,
          "dataSource": "",
          "configType": "",
          "options": [
            {
              "value": "AND",
              "label": "AND"
            },
            {
              "value": "OR",
              "label": "OR"
            }
          ],
          "valueType": "",
          "title": "",
          "text": "",
          "description": "简单模式下，conditions 列表会按这里设置的 AND 或 OR 逻辑联合判断。",
          "optionValueKey": "index",
          "transient": false,
          "action": "",
          "runtimeValueResolver": "",
          "visibleWhen": {
            "field": "mode",
            "equals": "simple"
          }
        },
        {
          "key": "result",
          "name": "result",
          "type": "text",
          "label": "命中结果",
          "placeholder": "条件命中时返回的值",
          "required": false,
          "rows": 4,
          "dataSource": "",
          "configType": "",
          "options": [],
          "valueType": "",
          "title": "",
          "text": "",
          "description": "简单模式下，conditions 组合判断成立时返回这里的值。",
          "optionValueKey": "index",
          "transient": false,
          "action": "",
          "runtimeValueResolver": "",
          "visibleWhen": {
            "field": "mode",
            "equals": "simple"
          }
        },
        {
          "key": "group_logic",
          "name": "group_logic",
          "type": "select",
          "label": "组间逻辑",
          "placeholder": "",
          "required": false,
          "rows": 4,
          "dataSource": "",
          "configType": "",
          "options": [
            {
              "value": "OR",
              "label": "OR"
            },
            {
              "value": "AND",
              "label": "AND"
            }
          ],
          "valueType": "",
          "title": "",
          "text": "",
          "description": "条件组模式下，各组判断完成后，再按这里的逻辑汇总。",
          "optionValueKey": "index",
          "transient": false,
          "action": "",
          "runtimeValueResolver": "",
          "visibleWhen": {
            "field": "mode",
            "equals": "groups"
          }
        },
        {
          "key": "default",
          "name": "default",
          "type": "text",
          "label": "默认值",
          "placeholder": "条件未命中时返回的值",
          "required": false,
          "rows": 4,
          "dataSource": "",
          "configType": "",
          "options": [],
          "valueType": "",
          "title": "",
          "text": "",
          "description": "简单模式和条件组模式都会用到这个兜底值。",
          "optionValueKey": "index",
          "transient": false,
          "action": "",
          "runtimeValueResolver": "",
          "visibleWhen": null
        },
        {
          "key": "remarks",
          "name": "remarks",
          "type": "textarea",
          "label": "备注",
          "placeholder": "补充当前规则的说明",
          "required": false,
          "rows": 3,
          "dataSource": "",
          "configType": "",
          "options": [],
          "valueType": "",
          "title": "",
          "text": "",
          "description": "建议写清楚字段口径、模式选择原因和维护说明。",
          "optionValueKey": "index",
          "transient": false,
          "action": "",
          "runtimeValueResolver": "",
          "visibleWhen": null
        },
        {
          "key": "",
          "name": "",
          "type": "info",
          "label": "字段7",
          "placeholder": "",
          "required": false,
          "rows": 4,
          "dataSource": "",
          "configType": "",
          "options": [],
          "valueType": "",
          "title": "复杂结构说明",
          "text": "简单模式下请在 JSON 区维护 conditions；条件组模式下请在 JSON 区维护 groups。",
          "description": "",
          "optionValueKey": "index",
          "transient": false,
          "action": "",
          "runtimeValueResolver": "",
          "visibleWhen": null
        }
      ],
      "summaryTemplate": "当前按 {{multi_mode_label}} 配置多字段判断，{{condition_or_group_summary}}，未命中返回 {{default}}",
      "jsonKeys": [
        "logic",
        "conditions",
        "result",
        "default",
        "group_logic",
        "groups",
        "remarks"
      ],
      "jsonExample": {
        "logic": "AND",
        "conditions": [],
        "result": "",
        "default": "",
        "group_logic": "OR",
        "groups": [],
        "remarks": ""
      },
      "initialValues": {},
      "saveTarget": "rule",
      "description": "这类配置适合多个字段联合决定输出结果的场景。当前已支持简单模式与条件组模式的动态切换，复杂的 conditions 或 groups 结构仍在 JSON 区维护。",
      "effectText": "保存后会直接影响当前列按简单模式还是条件组模式判断，以及命中和未命中时的输出结果。",
      "dependencyTextTemplate": "依赖 {{rule_source_name}} 多字段条件配置，当前为 {{multi_mode_label}}",
      "workflowSteps": [
        {
          "label": "读取多个字段",
          "text": "从 {{rule_source_name}} 读取多个条件字段，当前模式为 {{multi_mode_label}}"
        },
        {
          "label": "按模式判断",
          "text": "{{multi_mode_description}}"
        },
        {
          "label": "返回结果",
          "text": "{{multi_mode_result_description}}"
        }
      ]
    },
