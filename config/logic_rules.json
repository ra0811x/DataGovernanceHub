    "data_source_judge_crm": {
      "id": "data_source_judge_crm",
      "name": "多字段条件组_数据来源_归类判断",
      "type": "conditional_groups",
      "description": "标准多字段条件组规则。根据多个字段的条件组组合关系进行归类判断，组内按 AND 判断，组间按 OR 汇总，未命中时返回默认值。",
      "source_field": {
        "data_source": "merge_results",
        "field_index": 13,
        "field_name": "业务系统名称"
      },
      "group_logic": "OR",
      "groups": [
        {
          "description": "业务系统字段包含 CRM 且数据名称字段包含 身份证",
          "logic": "AND",
          "conditions": [
            {
              "field_index": 13,
              "match": "CRM",
              "operator": "contains"
            },
            {
              "field_index": 8,
              "match": "身份证",
              "operator": "contains"
            }
          ],
          "result": "用户提供"
        },
        {
          "description": "业务系统字段包含 CRM 且数据名称字段包含 证件",
          "logic": "AND",
          "conditions": [
            {
              "field_index": 13,
              "match": "CRM",
              "operator": "contains"
            },
            {
              "field_index": 8,
              "match": "证件",
              "operator": "contains"
            }
          ],
          "result": "用户提供"
        }
      ],
      "default": "生产运营中产生",
      "usage_count": 1,
      "used_in": [
        {
          "category": "yeji",
          "report_code": "i_10600_10002",
          "report_name": "数据资产字段信息表",
          "target_column": "Y",
          "target_name": "数据来源"
        }
      ],
      "created_at": "2026-03-09",
      "updated_at": "2026-03-09"
    },
