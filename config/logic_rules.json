    "guarantee_measures": {
      "id": "guarantee_measures",
      "name": "多字段条件组_保障措施_判断",
      "type": "conditional_groups",
      "description": "标准多字段条件组规则。根据数据分类和数据分级的组合关系返回保障措施结果，组间按 OR 汇总。",
      "source_field": {
        "data_source": "merge_results",
        "field_index": 9,
        "field_name": "数据分类"
      },
      "group_logic": "OR",
      "groups": [
        {
          "description": "数据分类属于 A-D 且数据分级为 1-2",
          "logic": "AND",
          "conditions": [
            {
              "field_index": 9,
              "match": "^[ABCD]",
              "regex": true
            },
            {
              "field_index": 10,
              "match": "(1|2)",
              "regex": true
            }
          ],
          "result": "4A管控"
        },
        {
          "description": "数据分类属于 A-D 且数据分级为 3-4",
          "logic": "AND",
          "conditions": [
            {
              "field_index": 9,
              "match": "^[ABCD]",
              "regex": true
            },
            {
              "field_index": 10,
              "match": "(3|4)",
              "regex": true
            }
          ],
          "result": "4A金库管控"
        }
      ],
      "default": "",
      "notes": "标准规则已按当前报表实际落地结构统一为条件组形式，索引口径与实际导出一致。",
      "usage_count": 3,
      "used_in": [
        {
          "category": "yeji",
          "report_code": "i_10600_10002",
          "report_name": "数据资产字段信息表",
          "target_column": "V",
